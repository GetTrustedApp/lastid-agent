    "lint": "eslint .",
    "format": "prettier --write .",
    "plugin:bump": "node scripts/bump-plugin-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GetTrustedApp/lastid-agent.git"
  },
  "homepage": "https://lastid.co",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lastid/lastid-sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-fetch": "^3.3.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0"
  }
}
